# Core Server & Database
NODE_ENV=development
PORT=4100
PAART_PUBLIC_URL=https://paart.in
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/paart_academy
SHOULD_SEED=true

# Multi-Role Session & Bootstrap Admin Credentials
PAART_AUTH_SECRET=replace-with-a-random-32-byte-secret-key-for-production
PAART_SESSION_TTL_HOURS=12
PAART_ADMIN_EMAIL=admin@paart.in
PAART_ADMIN_PASSWORD=change-me-strong-password

# Transactional Email (SMTP) — leave SMTP_HOST empty in local dev/test for MemoryTransport fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PAART Academy <no-reply@paart.in>"

# Honeypot Secret
PAART_HONEYPOT_SECRET=replace-with-a-random-honeypot-secret-key
